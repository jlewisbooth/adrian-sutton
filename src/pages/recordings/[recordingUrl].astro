---
import BaseLayout from "../../layouts/base.astro";
import { getCollection, render } from "astro:content";
import AudioPlayer from "../../components/audio-player.astro";
import { Image } from "astro:assets";

import FallbackBanner from "../../images/banner-fallback.png";
import FallbackCover from "../../images/fallback-title-image.jpeg";

const recordings = await getCollection("recordings");

export async function getStaticPaths() {
  const recordings = await getCollection("recordings");

  return recordings.map((recording) => ({
    params: { recordingUrl: recording.data.url },
  }));
}

const { recordingUrl } = Astro.params;

const recording = recordings.find(
  (recording) => recording.data.url === recordingUrl,
);

if (!recording) {
  throw new Error(`Recording ${recordingUrl} not found`);
}

const { Content } = await render(recording);
---

<style>
  .gradient {
    background-color: hsla(0, 0%, 100%, 1);
    background-image:
      radial-gradient(
        at 10% 14%,
        hsla(30, 82%, 55%, 0.47) 0px,
        transparent 50%
      ),
      radial-gradient(
        at 28% 81%,
        hsla(201, 47%, 34%, 0.52) 0px,
        transparent 50%
      ),
      radial-gradient(
        at 80% 77%,
        hsla(17, 74%, 52%, 0.56) 0px,
        transparent 50%
      ),
      radial-gradient(
        at 84% 22%,
        hsla(195, 26%, 52%, 0.35) 0px,
        transparent 50%
      );
  }
</style>
<BaseLayout staticHeader={true}>
  <div
    class="flex flex-row gap-4 pt-24 w-full px-4 gradient justify-center items-start min-h-[calc(100vh-50px)]"
  >
    <div class="flex flex-col gap-4 max-w-[650px] flex-grow pb-4">
      <div
        class="p-4 bg-white/50 rounded-md overflow-hidden w-full flex flex-col gap-3"
      >
        <iframe
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          frameborder="0"
          height="450"
          style="width:100%;max-width:660px;overflow:hidden;border-radius:10px;"
          sandbox="allow-forms allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
          src={recording.data.audioUrl}></iframe>
      </div>
      <div
        class="p-4 bg-white/50 rounded-md overflow-hidden w-full flex flex-col gap-3"
      >
        <h2 class="text-2xl font-bold text-center">{recording.data.title}</h2>
        <Content />
      </div>
    </div>
    <div class="flex flex-col gap-4 max-w-3xl pb-4 sticky top-24">
      <div
        class="container mx-auto bg-black rounded-md p-4 min-w-[300px] max-w-[300px] overflow-hidden relative flex flex-col justify-center items-center"
      >
        <div class="absolute top-0 left-0 w-full h-full z-0">
          <Image
            src={FallbackBanner}
            alt={recording.data.title}
            class="w-full h-full object-cover opacity-40"
          />
        </div>
        <div
          class="w-[160px] h-[160px] min-w-[160px] min-h-[160px] z-10 relative"
        >
          {
            recording.data.cover ? (
              <Image
                src={recording.data.cover}
                alt={recording.data.title}
                class="w-full h-full object-fit rounded-lg overflow-hidden"
              />
            ) : (
              <Image
                src={FallbackCover}
                alt={recording.data.title}
                class="w-full h-full object-fit rounded-lg overflow-hidden"
              />
            )
          }
        </div>
        <div class="flex flex-col gap-2 z-10 relative pt-4 text-white w-full">
          {
            recording.data.metadata?.map((metadata) => (
              <>
                <div class="flex flex-row gap-2 items-end w-full justify-between gap-2">
                  <span class="text-sm">{metadata.title}</span>
                  <span class="font-bold">{metadata.description}</span>
                </div>
                <hr class="h-px border-t-0 bg-transparent bg-gradient-to-r from-transparent via-neutral-500 to-transparent opacity-50 dark:via-neutral-400" />
              </>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
