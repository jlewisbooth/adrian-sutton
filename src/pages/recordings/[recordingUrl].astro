---
import BaseLayout from "../../layouts/base.astro";
import { getCollection, render } from "astro:content";
import PlayIcon from "../../components/smallPlayIcon.astro";
import PauseIcon from "../../components/smallPauseIcon.astro";
import AudioPlayer from "../../components/audio-player.astro";
import { Image } from "astro:assets";

import FallbackBanner from "../../images/banner-fallback.png";
import FallbackCover from "../../images/fallback-title-image.jpeg";

const recordings = await getCollection("recordings");

export async function getStaticPaths() {
  const recordings = await getCollection("recordings");

  return recordings.map((recording) => ({
    params: { recordingUrl: recording.data.url },
  }));
}

const { recordingUrl } = Astro.params;

const recording = recordings.find(
  (recording) => recording.data.url === recordingUrl,
);

if (!recording) {
  throw new Error(`Recording ${recordingUrl} not found`);
}

const { Content } = await render(recording);

const records = recording.data.records?.map((record) => {
  return {
    title: record.title,
    url: record.url
      ? `${import.meta.env.BASE_URL}api/serve-recording/${encodeURIComponent(record.url)}`
      : null,
  };
});
---

<style>
  .gradient {
    background-color: hsla(0, 0%, 100%, 1);
    background-image:
      radial-gradient(
        at 10% 14%,
        hsla(30, 82%, 55%, 0.47) 0px,
        transparent 50%
      ),
      radial-gradient(
        at 28% 81%,
        hsla(201, 47%, 34%, 0.52) 0px,
        transparent 50%
      ),
      radial-gradient(
        at 80% 77%,
        hsla(17, 74%, 52%, 0.56) 0px,
        transparent 50%
      ),
      radial-gradient(
        at 84% 22%,
        hsla(195, 26%, 52%, 0.35) 0px,
        transparent 50%
      );
  }
</style>
<BaseLayout staticHeader={true}>
  <div
    class="flex flex-row gap-4 pt-24 w-full px-4 gradient justify-center items-start min-h-[calc(100vh-50px)]"
  >
    <div class="flex flex-col gap-4 max-w-2xl pb-4 sticky top-24">
      <div class="container mx-auto bg-black/50 rounded-md p-4 min-w-[230px]">
        <h2 class="text-2xl font-bold text-white">Track listing</h2>
        <div class="divider divider-secondary"></div>
        <div class="flex flex-col gap-2">
          {
            records &&
              records.map((record, index) => (
                <div class="flex flex-row gap-3 justify-between items-center">
                  <h6 class="text-white">{`${index + 1}. ${record.title}`}</h6>
                  {record.url && (
                    <label class="btn btn-circle btn-sm btn-secondary swap text-primary drop-shadow-md">
                      <input
                        type="checkbox"
                        class="card-pay-buttons"
                        id={record.url}
                        data-audio-url={record.url}
                        aria-label="Play and pause"
                      />
                      <div class="swap-off">
                        <PlayIcon class="text-contrast" />
                      </div>
                      <div class="swap-on text-contrast">
                        <PauseIcon class="text-contrast" />
                      </div>
                    </label>
                  )}
                </div>
              ))
          }
        </div>
      </div>
    </div>
    <div class="flex flex-col gap-2 max-w-[600px] flex-grow pb-4">
      <div
        class="flex flex-row gap-2 relative h-48 justify-center items-center rounded-md overflow-hidden bg-black w-full"
      >
        <div class="absolute top-0 left-0 w-full h-full z-0">
          {
            recording.data.banner ? (
              <Image
                src={recording.data.banner}
                alt={recording.data.title}
                class="w-full h-full object-cover opacity-40"
              />
            ) : (
              <Image
                src={FallbackBanner}
                alt={recording.data.title}
                class="w-full h-full object-cover opacity-40"
              />
            )
          }
        </div>
        <div class="relative z-10 flex flex-row gap-4 p-4 items-center">
          <div class="w-24 h-24 rounded-lg overflow-hidden">
            {
              recording.data.cover ? (
                <Image src={recording.data.cover} alt={recording.data.title} />
              ) : (
                <Image src={FallbackCover} alt={recording.data.title} />
              )
            }
          </div>
          <div class="flex flex-col gap-2">
            <h2 class="text-3xl font-bold text-white">
              {`${recording.data.title}`}
            </h2>
          </div>
        </div>
      </div>
      <div
        class="p-4 bg-white/50 rounded-md overflow-hidden w-full flex flex-col gap-3"
      >
        <Content />
      </div>
    </div>
  </div>
  <AudioPlayer />
</BaseLayout>
