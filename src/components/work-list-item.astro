---
import PlayIcon from "./playIcon.astro";
import PauseIcon from "./pauseIcon.astro";
import CheckeredImage from "../images/fallback-title-image.png";
import { Image } from "astro:assets";
const { work } = Astro.props;

const audioPath = work.data.audio
  ? `${import.meta.env.BASE_URL}api/serve-audio/${encodeURIComponent(work.data.workNumber)}`
  : null;
const pdfPath = work.data.pdf
  ? work.data.pdf.replace("./", "../../works/") + "?url"
  : null;
---

<div
  class="bg-white/70 rounded-lg flex flex-row gap-4 overflow-hidden drop-shadow-lg h-full"
>
  <div class="flex flex-col gap-1 p-3 flex-grow">
    <div class="flex flex-col gap-1 justify-start items-start w-full">
      <h2
        class="text-xl font-bold text-[#2e6280] drop-shadow-[0_1px_0px_var(--tw-shadow-color)] shadow-secondaryDark"
      >
        {`${work.data.title} (${work.data.compositionYear})`}
      </h2>
      <div class="flex flex-row gap-2">
        {
          work.data.length && (
            <p class="text-md font-bold text-nowrap">({work.data.length})</p>
          )
        }
        {
          work.data.forces && (
            <p class="text-md font-bold">{work.data.forces}</p>
          )
        }
      </div>
    </div>
    <div class="flex-grow">
      <p class="text-md pb-1">{work.data.shortDesc}</p>
    </div>
    <div class="flex flex-row gap-2">
      {
        work.data.moreInfo && (
          <a href={`${import.meta.env.BASE_URL}works/${work.data.workNumber}`}>
            <button class="btn btn-primary btn-sm text-white relative overflow-hidden drop-shadow-sm">
              <span class="relative z-10 text-nowrap">More Info</span>
              <Image
                src={CheckeredImage}
                alt=""
                class="absolute inset-0 w-full h-full object-cover opacity-70 z-0"
              />
            </button>
          </a>
        )
      }
      {
        pdfPath && (
          <a
            href={`${import.meta.env.BASE_URL}api/serve-pdf/${encodeURIComponent(work.data.workNumber)}`}
            target="_blank"
          >
            <button class="btn btn-neutral btn-sm text-white drop-shadow-sm text-nowrap">
              Score Excerpt
            </button>
          </a>
        )
      }
      {
        work.data.recording && (
          <a href={work.data.recording} target="_blank">
            <button class="btn btn-neutral btn-sm text-white drop-shadow-sm text-nowrap">
              Recording
            </button>
          </a>
        )
      }
      {
        work.data.buy && (
          <a href={work.data.buy} target="_blank">
            <button class="btn btn-neutral btn-sm text-white drop-shadow-sm text-nowrap">
              Buy Score
            </button>
          </a>
        )
      }
      {
        work.data.hire && (
          <a
            href={`mailto:cordafonia@gmail.com?subject=Enquiry: ${work.data.workNumber} - ${work.data.title}`}
            target="_blank"
          >
            <button class="btn btn-neutral btn-sm text-white drop-shadow-sm text-nowrap">
              Contact for Hire
            </button>
          </a>
        )
      }
    </div>
  </div>
  <div class="flex justify-center items-center p-2">
    {
      audioPath && (
        <label class="btn btn-circle btn-secondary swap md:mx-2 text-primary drop-shadow-md">
          <input
            type="checkbox"
            class="card-pay-buttons"
            id={work.data.workNumber}
            data-audio-url={audioPath}
            aria-label="Play and pause"
          />
          <div class="swap-off">
            <PlayIcon class="text-contrast" />
          </div>
          <div class="swap-on text-contrast">
            <PauseIcon class="text-contrast" />
          </div>
        </label>
      )
    }
  </div>
</div>
